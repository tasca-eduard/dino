{
  "name": "dino-farm",
  "version": "0.1.0",
  "description": "Co-op multiplayer third-person dinosaur farming game for the browser",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:raid": "tsx scripts/raid-test.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
